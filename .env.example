# Copy this file to .env on the server and fill it in. Never commit .env.

# Address people open in the browser (no trailing slash). Must match the
# "Authorized redirect URI" in Google Cloud: <PUBLIC_URL>/auth/callback
PUBLIC_URL=https://tracker.your-test-domain.webel.io

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only Google Workspace accounts on this domain can sign in.
ALLOWED_DOMAIN=webel.io

# Optional: limit access to these people (comma-separated). Empty = anyone @webel.io.
ALLOWED_EMAILS=
# Optional: these people can view but not edit (comma-separated).
READONLY_EMAILS=

# How long a sign-in lasts, in days.
SESSION_DAYS=14

# The app listens here; nginx forwards public HTTPS traffic to it.
HOST=127.0.0.1
PORT=8765

# Re-sync from the CRM every N hours (0 = only when someone clicks "Sync from CRM").
AUTO_SYNC_HOURS=6

# Optional: database location (default: data/tracker.db)
# DB_PATH=/var/lib/project-tracker/tracker.db
