# Copy this file to .env and fill it in. Restart the server after changing it.

# The ONE login everyone uses (any PC). Password: at least 6 characters.
LOGIN_ID=admin
LOGIN_PASSWORD=change-me
# Name shown as "who changed it" in the Activity log
LOGIN_NAME=Admin

# 0.0.0.0 = other PCs on the network can open the dashboard; 127.0.0.1 = this PC only
HOST=0.0.0.0
PORT=8765

# Public HTTPS address, if deployed on a server (makes login cookies HTTPS-only)
# PUBLIC_URL=https://tracker.example.com
